# Copy to meridian-agent/.env for local runs (pydantic-settings reads it from the working directory),
# or to ./.env for docker compose variable substitution. Every value has a safe default; nothing is required.

# --- Backend (meridian-agent) ---
MERIDIAN_DATABASE_URL=sqlite:///./meridian.db
MERIDIAN_LOG_LEVEL=INFO
MERIDIAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
MERIDIAN_SEED_SAMPLE_DATA=true

# LLM: "mock" (deterministic, offline) or "openai-compatible"
MERIDIAN_LLM_PROVIDER=mock
MERIDIAN_LLM_BASE_URL=http://localhost:11434/v1
MERIDIAN_LLM_API_KEY=
MERIDIAN_LLM_MODEL=gpt-4o-mini
MERIDIAN_LLM_TIMEOUT_SECONDS=30
MERIDIAN_LLM_LOG_FULL_IO=false

MERIDIAN_TRACKER_ENABLED=true
MERIDIAN_AT_RISK_THRESHOLD_DAYS=3
MERIDIAN_MAX_UPLOAD_BYTES=2097152
MERIDIAN_STREAM_STEP_DELAY_MS=250

# Mocked system providers: only "mock" is implemented; any other value raises NotImplementedError.
MERIDIAN_PORTFOLIO_PROVIDER=mock
MERIDIAN_CMDB_PROVIDER=mock
MERIDIAN_ITSM_RISK_PROVIDER=mock
MERIDIAN_SECPORTAL_PROVIDER=mock
MERIDIAN_DRA_PROVIDER=mock
MERIDIAN_ARCHPORTAL_PROVIDER=mock
MERIDIAN_TRACKER_PROVIDER=mock

# --- Frontend (meridian-ui) ---
# Build-time defaults for `npm run dev`; the header switch overrides them at runtime.
VITE_USE_MOCK=true
VITE_API_BASE_URL=
# docker compose: whether the containerised UI starts in mock mode
UI_USE_MOCK=false
